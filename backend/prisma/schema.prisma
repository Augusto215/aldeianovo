// Schema Prisma — modelagem base do Sistema de Gestão Integrado.
// Etapa 1: gestão financeira. Etapa 2: GED (modelos já previstos abaixo).
// Rode `npm run prisma:migrate` após configurar DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase: DATABASE_URL pode ser o pooler (transaction mode, porta 6543);
  // DIRECT_URL deve ser a conexão direta/session (porta 5432) para migrations.
  // Se usar uma única conexão session mode, repita o mesmo valor nas duas.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Usuários e permissões (Etapa 1)
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COORDENACAO
  FINANCEIRO
  LEITURA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(FINANCEIRO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Recuperação de senha
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Autenticação em dois fatores (2FA) — requisito do GED
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  transactions     Transaction[]
  documents        Document[]        @relation("DocumentOwner")
  documentVersions DocumentVersion[]
  auditLogs        AuditLog[]
}

// ─────────────────────────────────────────────────────────────
// Financeiro (Etapa 1)
// ─────────────────────────────────────────────────────────────

enum AccountType {
  CORRENTE
  POUPANCA
  CAIXA
}

enum TxType {
  RECEITA
  DESPESA
}

enum TxStatus {
  PAGO
  PENDENTE
}

model Account {
  id        String      @id @default(cuid())
  name      String
  bank      String?
  type      AccountType @default(CORRENTE)
  balance   Decimal     @default(0) @db.Decimal(14, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions Transaction[]
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  transactions Transaction[]
}

model Transaction {
  id          String    @id @default(cuid())
  description String
  amount      Decimal   @db.Decimal(14, 2)
  type        TxType
  status      TxStatus  @default(PENDENTE)
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  account    Account  @relation(fields: [accountId], references: [id])
  accountId  String
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
  createdBy  User?     @relation(fields: [userId], references: [id])
  userId     String?

  @@index([date])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────
// GED — Gestão Eletrônica de Documentos (Etapa 2)
// Modelagem prevista; implementação inicia após a Etapa 1.
// ─────────────────────────────────────────────────────────────

enum DocumentStatus {
  RASCUNHO
  EM_REVISAO
  APROVADO   // apenas a versão aprovada fica visível
  CONGELADO  // documento finalizado — não pode mais ser alterado
  ARQUIVADO  // arquivamento definitivo após vencer a temporalidade
  DESCARTADO // descarte seguro após vencer a temporalidade
}

model Document {
  id     String         @id @default(cuid())
  status DocumentStatus @default(RASCUNHO)

  // Metadados obrigatórios — exigidos antes de salvar
  projectName String   // Nome do projeto
  funder      String   // Financiador
  docType     String   // Tipo de documento
  issuedAt    DateTime // Data de emissão
  validUntil  DateTime // Vigência

  // OCR: texto extraído para pesquisa por palavras-chave
  ocrText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation("DocumentOwner", fields: [ownerId], references: [id])
  ownerId String

  retentionRule   RetentionRule? @relation(fields: [retentionRuleId], references: [id])
  retentionRuleId String?

  versions  DocumentVersion[]
  auditLogs AuditLog[]

  @@index([projectName])
  @@index([docType])
  @@index([validUntil])
}

model DocumentVersion {
  id       String  @id @default(cuid())
  major    Int     // v2.0 → major = 2
  minor    Int     // v1.1 → minor = 1
  approved Boolean @default(false) // apenas a versão aprovada fica visível
  filePath String  // arquivo original armazenado
  pdfaPath String? // conversão automática para PDF/A
  fileHash String  // integridade do arquivo
  notes    String? // descrição da alteração

  createdAt DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id])
  documentId String
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String

  @@unique([documentId, major, minor])
}

enum AuditAction {
  VISUALIZOU
  BAIXOU
  EDITOU
  ASSINOU
  EXCLUIU
}

// Trilha de auditoria: permanente e imutável.
// Sem updatedAt e sem exclusão — a aplicação NÃO deve expor UPDATE/DELETE
// nesta tabela (nem para administradores); reforçar com permissões no banco
// (ex.: REVOKE UPDATE, DELETE ON "AuditLog" FROM app_role).
model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  ipAddress String      // endereço IP de origem
  createdAt DateTime    @default(now()) // data e hora do evento

  user   User   @relation(fields: [userId], references: [id])
  userId String

  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?

  @@index([createdAt])
  @@index([userId])
  @@index([documentId])
}

// Temporalidade: ex. "documentos financeiros guardados por 10 anos".
// Ao vencer: alerta automático à coordenação; permite descarte seguro
// ou arquivamento definitivo.
model RetentionRule {
  id             String  @id @default(cuid())
  name           String  @unique // ex.: "Financeiro — 10 anos"
  docType        String  // tipo de documento a que se aplica
  retentionYears Int     // prazo de guarda em anos
  notifyOnExpiry Boolean @default(true) // avisar coordenação ao vencer

  documents Document[]
}
