# Porta do servidor
PORT=3333

# Origem permitida (frontend em dev)
CORS_ORIGIN=http://localhost:5173

# ── Banco de dados (Supabase / PostgreSQL) ─────────────────────────────
# No painel do Supabase: Connect → ORMs → Prisma.
#
# DATABASE_URL  → connection pooling (transaction mode, porta 6543)
# DIRECT_URL    → conexão direta ou session mode (porta 5432), usada
#                 pelas migrations do Prisma.
#
# Se tiver só uma connection string (session mode), use o mesmo valor nas duas.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Segredo do JWT (troque em produção)
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"
