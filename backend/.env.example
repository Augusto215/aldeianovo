# Porta do servidor
PORT=3333

# Origem permitida (frontend em dev)
CORS_ORIGIN=http://localhost:5173

# ── Banco de dados (Supabase) ───────────────────────────────────────────
# No painel do Supabase: Project Settings → API.
# Rode backend/sql/schema.sql uma vez no SQL Editor do projeto antes de subir a API.
# SUPABASE_SERVICE_ROLE_KEY é uma chave privilegiada (ignora RLS) — nunca
# exponha ao frontend, só o backend deve usá-la.
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUA_CHAVE_SERVICE_ROLE"

# Segredo do JWT (troque em produção)
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Verificação em duas etapas (código por e-mail no login). Desativado por
# padrão; defina "true" para reativar.
TWO_FACTOR_ENABLED="false"

# ── E-mail (código de verificação em duas etapas / recuperação de senha) ──
# Sem essas variáveis, o código/link aparece no log do servidor (modo
# simulado) em vez de ser enviado de verdade. Exemplo com Gmail/Google
# Workspace: gere uma "senha de app" em myaccount.google.com/apppasswords.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
